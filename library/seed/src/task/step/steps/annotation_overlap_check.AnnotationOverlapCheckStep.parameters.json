{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gene overlap check",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "output": {
      "type": "string",
      "default": "annotation_overlap_check",
      "title": "Output name",
      "description": "Step output name."
    },
    "gene_dim": {
      "type": "string",
      "default": "gene",
      "title": "Gene axis",
      "description": "Row axis label."
    },
    "field_dim": {
      "type": "string",
      "default": "field",
      "title": "Field axis",
      "description": "Column axis label."
    }
  }
}
