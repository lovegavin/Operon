{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "output": {
      "type": "string",
      "default": "lof_outlier_score_out"
    },
    "row_dim": {
      "type": "string",
      "default": "row"
    },
    "field_dim": {
      "type": "string",
      "default": "field"
    },
    "k": {
      "type": "integer",
      "default": 5,
      "title": "k"
    },
    "threshold": {
      "type": "number",
      "default": 1.5,
      "title": "threshold"
    }
  },
  "required": [
    "row_dim",
    "field_dim"
  ]
}
