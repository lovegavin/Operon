{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StructureExtractChain parameters",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {"type": "string", "default": "atom", "description": "Atom dimension name."},
    "field_dim": {"type": "string", "default": "field", "description": "Field dimension name."},
    "output": {"type": "string", "default": "output", "description": "Output port name."},
    "filename": {"type": "string", "default": "chain.pdb", "pattern": "^[A-Za-z0-9._-]+\\.pdb$"},
    "chains": {"type": "string", "default": "A", "description": "Comma-separated chain identifiers, for example A,B."},
    "include_hetatm": {"type": "boolean", "default": false}
  }
}
