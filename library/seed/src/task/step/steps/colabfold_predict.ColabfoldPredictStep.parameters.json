{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "title": "ColabFold 结构预测",
  "description": "调用官方 colabfold_batch 预测单条序列的结构并读取置信度。",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "type": "string",
      "default": "sequence",
      "title": "序列维度名",
      "x-ui-group": "advanced",
      "x-ui-order": 10
    },
    "position_dim": {
      "type": "string",
      "default": "position",
      "title": "位点维度名",
      "x-ui-group": "advanced",
      "x-ui-order": 20
    },
    "colabfold_path": {
      "type": "string",
      "default": "colabfold_batch",
      "title": "colabfold_batch 路径（默认取 PATH）",
      "x-ui-group": "basic",
      "x-ui-order": 10
    },
    "num_models": {
      "type": "integer",
      "default": 1,
      "title": "模型数",
      "x-ui-group": "basic",
      "x-ui-order": 30,
      "minimum": 1,
      "maximum": 5
    },
    "num_recycles": {
      "type": "integer",
      "default": 3,
      "title": "循环次数",
      "x-ui-group": "basic",
      "x-ui-order": 40,
      "minimum": 1,
      "maximum": 48
    },
    "msa_mode": {
      "type": "string",
      "default": "mmseqs2_uniref_env",
      "title": "MSA 模式",
      "x-ui-group": "advanced",
      "x-ui-order": 50,
      "enum": [
        "mmseqs2_uniref_env",
        "mmseqs2_uniref",
        "single_sequence"
      ]
    },
    "msa_host": {
      "type": "string",
      "default": "",
      "title": "MSA 服务器地址（留空用 ColabFold 默认）",
      "x-ui-group": "advanced",
      "x-ui-order": 55
    },
    "device": {
      "type": "string",
      "default": "auto",
      "title": "运行设备",
      "x-ui-group": "advanced",
      "x-ui-order": 60,
      "enum": [
        "auto",
        "cpu",
        "cuda"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "default": 3600,
      "title": "超时（秒）",
      "x-ui-group": "advanced",
      "x-ui-order": 70,
      "minimum": 60,
      "maximum": 86400
    },
    "output": {
      "type": "string",
      "default": "structure",
      "title": "输出名",
      "x-ui-group": "basic",
      "x-ui-order": 10
    },
    "msa_databases": {
      "type": "string",
      "default": "",
      "title": "本地 MSA 数据库根目录（可选）",
      "description": "包含 uniref30_2302/uniref30_2302_db 与 colabfold_envdb_202108/colabfold_envdb_202108_db 的 MMseqs2 索引目录；留空则用 --host-url 的远程服务。",
      "x-ui-group": "advanced",
      "x-ui-order": 56
    },
    "msa_db1": {
      "type": "string",
      "default": "",
      "title": "UniRef30 数据库前缀（可选）",
      "description": "显式指定 --db1 的路径前缀；设置后覆盖 msa_databases。",
      "x-ui-group": "advanced",
      "x-ui-order": 57
    },
    "msa_db2": {
      "type": "string",
      "default": "",
      "title": "环境序列数据库前缀（可选）",
      "description": "显式指定 --db2 的路径前缀；设置后自动追加 --use-env 1。",
      "x-ui-group": "advanced",
      "x-ui-order": 58
    },
    "sequence_index": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "title": "第几条序列（多序列设计时使用）",
      "description": "ProteinMPNN 一次给出多条序列时，折叠其中第几条（0 起）。每个设计配一条折叠分支时留 0。",
      "x-ui-group": "advanced",
      "x-ui-order": 57
    },
    "mmseqs_path": {
      "type": "string",
      "default": "",
      "title": "MMseqs2 binary",
      "description": "Optional MMseqs2 executable used by colabfold_search; defaults to the mmseqs shipped beside colabfold_batch.",
      "x-ui-group": "advanced",
      "x-ui-order": 58
    },
    "msa_threads": {
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "title": "MSA threads",
      "description": "Threads for the local MMseqs2 search.",
      "x-ui-group": "advanced",
      "x-ui-order": 59
    }
  }
}
