{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "row_dim": {
      "type": "string",
      "default": "row"
    },
    "field_dim": {
      "type": "string",
      "default": "field"
    },
    "output": {
      "type": "string"
    },
    "sequence_column": {
      "type": "string",
      "default": "seq"
    },
    "model_path": {
      "type": "string",
      "default": ""
    },
    "max_length": {
      "type": "integer",
      "minimum": 16,
      "default": 512
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "default": 8
    }
  },
  "required": [
    "row_dim",
    "field_dim",
    "batch_size",
    "max_length",
    "model_path",
    "sequence_column"
  ]
}
