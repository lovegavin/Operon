{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GO information content profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "obo_path": {
      "type": "string",
      "default": "",
      "description": "Required: absolute path to the local OBO file for this run."
    },
    "gaf_path": {
      "type": "string",
      "default": "",
      "description": "Required: absolute path to the local GAF file for this run."
    },
    "aspect": {
      "type": "string",
      "enum": [
        "P",
        "F",
        "C",
        "all"
      ],
      "default": "P"
    },
    "output": {
      "type": "string",
      "default": "go_ic_profile"
    },
    "row_dim": {
      "type": "string",
      "default": "term"
    },
    "field_dim": {
      "type": "string",
      "default": "field"
    },
    "term_field": {
      "type": "string",
      "default": "term"
    }
  }
}
