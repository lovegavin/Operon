{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "output": {
      "type": "string",
      "default": "graph_pseudotime_out"
    },
    "row_dim": {
      "type": "string",
      "default": "row"
    },
    "field_dim": {
      "type": "string",
      "default": "field"
    },
    "n_components": {
      "type": "integer",
      "default": 5
    },
    "n_neighbors": {
      "type": "integer",
      "default": 10
    },
    "root_cell": {
      "type": "integer",
      "default": 0
    }
  }
}
