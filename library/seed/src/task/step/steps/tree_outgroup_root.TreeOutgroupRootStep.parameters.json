{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TreeOutgroupRootStep",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "row_dim": {
      "type": "string",
      "default": "row"
    },
    "field_dim": {
      "type": "string",
      "default": "field"
    },
    "outgroup": {
      "type": "string",
      "default": ""
    },
    "output": {
      "type": "string",
      "default": "rooted"
    }
  },
  "required": [
    "row_dim",
    "field_dim",
    "outgroup"
  ]
}
