{
  "version": 1,
  "environments": {
    "antifold": {
      "title": "AntiFold antibody inverse folding",
      "python": "3.11",
      "imports": [
        "antifold",
        "antifold.main"
      ],
      "requirements": [
        "torch==2.3.1",
        "numpy==1.26.4",
        "pandas==2.2.3",
        "tqdm",
        "scipy==1.13.1",
        "pydantic==2.14.3",
        "jsonschema==4.26.0"
      ],
      "no_deps": [
        "antifold==0.3.1"
      ],
      "weights": [
        {
          "path": "antifold/trained_models/model.pt",
          "url": "https://opig.stats.ox.ac.uk/data/downloads/AntiFold/models/model.pt"
        }
      ],
      "notes": "AntiFold pins NumPy 1.26 and Torch 2.3.1, incompatible with the shared NumPy 2 / Torch 2.6 runtime; pygam has no wheel and is not required for inference.",
      "conda_packages": [
        "numpy=1.26",
        "scikit-learn=1.6"
      ],
      "pip_wheels": [
        "biotite==0.38",
        "torch-geometric==2.4.0",
        "biopython==1.83"
      ],
      "torch_index_url": "https://mirrors.aliyun.com/pypi/simple",
      "torch_cuda": true,
      "torch_version": "2.3.1"
    },
    "boltz": {
      "title": "Boltz structure and affinity prediction",
      "python": "3.11",
      "imports": [
        "boltz"
      ],
      "conda_packages": [],
      "pip_wheels": [
        "numpy==1.26.4",
        "pandas==2.2.3",
        "scipy==1.13.1",
        "scikit-learn==1.6.1",
        "numba==0.61.0",
        "rdkit==2024.3.2",
        "gemmi==0.6.5",
        "dm-tree==0.1.8",
        "pillow",
        "tqdm",
        "requests==2.32.3",
        "types-requests",
        "pytorch-lightning==2.5.0",
        "lightning-utilities",
        "mashumaro==3.14",
        "einx==0.3.0",
        "einops==0.8.0",
        "chembl_structure_pipeline==1.2.2",
        "biopython==1.84",
        "frozendict",
        "wandb==0.18.7",
        "click==8.1.7",
        "pyyaml==6.0.2",
        "omegaconf==2.3.0"
      ],
      "pip_pypi": [
        "antlr4-python3-runtime==4.9.3",
        "ihm",
        "hydra-core==1.3.2",
        "modelcif==1.2",
        "fairscale==0.4.13"
      ],
      "requirements": [],
      "no_deps": [
        "boltz==2.2.1"
      ],
      "wired": true,
      "notes": "CUDA 12.1 torch wheel; GPU required.",
      "torch_version": "2.3.1",
      "torch_cuda": true,
      "torch_index_url": "https://download.pytorch.org/whl/cu121"
    },
    "colabfold": {
      "title": "ColabFold (local runner)",
      "python": "3.11",
      "imports": [
        "colabfold"
      ],
      "requirements": [
        "colabfold[alphafold]==1.5.5",
        "pydantic==2.14.3",
        "jsonschema==4.26.0",
        "pandas==1.5.3",
        "dm-haiku==0.0.13"
      ],
      "conda_packages": [],
      "torch_cpu": true,
      "wired": true,
      "notes": "colabfold 1.5.5 requires pandas<2, so this environment pins pandas 1.5.3; dm-haiku 0.0.13 is required because jax 0.4.38 removed jax.linear_util that haiku 0.0.10 used. colabfold_batch lives in the environment bin directory; the MMseqs2/UniRef databases remain external (resources.json colabfold).",
      "torch_version": "2.3.1",
      "torch_index_url": "https://mirrors.aliyun.com/pypi/simple"
    },
    "esm3": {
      "title": "ESM-3 sequence and structure generation",
      "python": "3.11",
      "imports": [
        "esm",
        "esm.sdk.api"
      ],
      "requirements": [
        "torch==2.6.0",
        "transformers<4.48.2",
        "tokenizers",
        "huggingface_hub",
        "httpx",
        "requests",
        "cloudpathlib",
        "einops",
        "safetensors",
        "dataclasses-json",
        "zstd",
        "accelerate",
        "attrs",
        "biotite",
        "pandas==2.2.3",
        "numpy==2.1.3",
        "scipy==1.14.1",
        "tqdm",
        "brotli",
        "msgpack-numpy",
        "meson-python",
        "ninja",
        "cython",
        "pydantic==2.14.3",
        "jsonschema==4.26.0",
        "esm==3.2.0",
        "scikit-learn==1.5.2"
      ],
      "no_deps": [],
      "notes": "esm 3.2.2+ requires Python >= 3.12 while the bridge runs Python 3.11, so this environment pins esm==3.2.0 (same operator surface) plus scikit-learn 1.5.2, the last release with a cp311 wheel. open ESM3 weights are fetched from Hugging Face on first use; gated checkpoints need a token the operator cannot supply.",
      "wired": true,
      "pip_wheels": [
        "setuptools",
        "wheel",
        "flit-core",
        "hatchling",
        "tenacity",
        "torchvision"
      ],
      "no_build_isolation": [],
      "torch_index_url": "https://mirrors.aliyun.com/pypi/simple",
      "torch_cuda": true,
      "torch_version": "2.6.0"
    },
    "esmfold": {
      "title": "ESMFold (fair-esm)",
      "python": "3.11",
      "imports": [
        "esm",
        "torch"
      ],
      "requirements": [
        "numpy==1.26.4",
        "biopython==1.83",
        "scipy==1.13.1",
        "ml-collections",
        "einops",
        "omegaconf==2.3.0",
        "pytorch-lightning",
        "dm-tree",
        "pydantic==2.14.3",
        "jsonschema==4.26.0",
        "pandas==2.2.3"
      ],
      "pip_pypi": [
        "fair-esm==2.0.0",
        "transformers==4.46.3"
      ],
      "wired": true,
      "notes": "fair-esm + HF transformers path. pandas/pydantic/jsonschema are required because the isolated worker reads the predicted PDB back through PdbReader. The 3B fp32 weights do not fit a 24 GB card; run on CPU or with the fp16 dtype option.",
      "torch_version": "2.3.1",
      "torch_cuda": true,
      "torch_index_url": "https://mirrors.aliyun.com/pypi/simple"
    },
    "openmm81": {
      "title": "OpenMM 8.1.1 structure preparation (PDBFixer bundled)",
      "python": "3.11",
      "imports": [
        "openmm",
        "numpy"
      ],
      "requirements": [
        "openmm==8.1.1",
        "numpy==1.26.4",
        "setuptools>=68,<81",
        "wheel"
      ],
      "notes": "OpenMM 8.1.1 wheels use the NumPy 1 ABI. This isolated venv shares the host Python (3.11 on Studio 4.1.9; venv_shared ignores the declared version) and pins OpenMM 8.1.1 plus NumPy 1.26 without downgrading the shared NumPy 2 runtime. PDBFixer 1.9 is bundled inside the operator library, so environment creation needs no GitHub download and no external pdbfixer package.",
      "pip_wheels": [
        "setuptools>=68,<81",
        "wheel"
      ],
      "venv_shared": true
    }
  }
}
