    "openmm81": {
      "title": "OpenMM 结构准备",
      "python": "3.11",
      "imports": [
        "openmm",
        "numpy"
      ],
      "requirements": [
        "openmm==8.1.1",
        "numpy==1.26.4",
        "setuptools>=68,<81",
        "wheel"
      ],
      "notes": "OpenMM 8.1.1 wheels use the NumPy 1 ABI. This isolated venv shares the host Python (3.11 on Studio 4.1.9; venv_shared ignores the declared version) and pins OpenMM 8.1.1 plus NumPy 1.26 without downgrading the shared NumPy 2 runtime. PDBFixer 1.9 is bundled inside the operator library, so environment creation needs no GitHub download and no external pdbfixer package.",
      "pip_wheels": [
        "setuptools>=68,<81",
        "wheel"
      ],
      "venv_shared": true,
      "resources": []
    },
    "openfold": {
      "title": "OpenFold 结构预测",
      "python": "3.11",
      "imports": [
        "torch",
        "numpy",
        "Bio",
        "ml_collections",
        "absl",
        "scipy",
        "pandas",
        "tree",
        "modelcif",
        "pdbfixer",
        "openmm"
      ],
      "requirements": [
        "numpy==1.26.4",
        "biopython==1.83",
        "scipy==1.13.1",
        "ml-collections==0.1.1",
        "absl-py",
        "pandas==2.2.3",
        "dm-tree==0.1.8",
        "modelcif",
        "ihm",
        "pydantic==2.14.3",
        "jsonschema==4.26.0"
      ],
      "wired": true,
      "notes": "OpenFold's relaxation path imports pdbfixer and openmm at module scope, so the vendored run_pretrained_openfold.py cannot start without them. Neither ships a cp311 wheel on PyPI (pdbfixer is absent, openmm only reaches 8.1.1), therefore both come from conda-forge; numpy=1.26 keeps the conda solve aligned with the pinned numpy==1.26.4 that torch 2.3.1 was installed against.",
      "torch_version": "2.3.1",
      "torch_cuda": true,
      "torch_index_url": "https://mirrors.aliyun.com/pypi/simple",
      "resources": [
        "openfold"
      ],
      "conda_packages": [
        "openmm=8.2",
        "pdbfixer=1.11",
        "numpy=1.26"
      ]
    },
