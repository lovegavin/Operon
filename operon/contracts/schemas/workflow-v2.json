{
  "$defs": {
    "RouteSpec": {
      "additionalProperties": false,
      "properties": {
        "graph": {
          "$ref": "#/$defs/WorkflowSpec"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "graph"
      ],
      "title": "RouteSpec",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "dims": {
          "default": [
            "sample",
            "feature"
          ],
          "items": {
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "labels": {
          "additionalProperties": true,
          "title": "Labels",
          "type": "object"
        },
        "location": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "path": {
          "default": "",
          "maxLength": 2048,
          "title": "Path",
          "type": "string"
        },
        "reader": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader"
        },
        "storage_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorageInputRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SourceSpec",
      "type": "object"
    },
    "StorageInputRef": {
      "additionalProperties": false,
      "description": "Versioned saved source selection; it grants no filesystem permission.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "format": {
          "const": "operon.storage-input",
          "default": "operon.storage-input",
          "title": "Format",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "storage_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Storage Id",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "storage_id",
        "relative_path",
        "version"
      ],
      "title": "StorageInputRef",
      "type": "object"
    },
    "WorkflowEdge": {
      "additionalProperties": false,
      "properties": {
        "adaptation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptation"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_handle": {
          "default": "out",
          "maxLength": 100,
          "title": "Source Handle",
          "type": "string"
        },
        "target": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "target_handle": {
          "default": "in-0",
          "pattern": "^in-\\d+$",
          "title": "Target Handle",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "WorkflowEdge",
      "type": "object"
    },
    "WorkflowNode": {
      "additionalProperties": false,
      "properties": {
        "context_params": {
          "additionalProperties": true,
          "title": "Context Params",
          "type": "object"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_count": {
          "default": 1,
          "maximum": 20,
          "minimum": 0,
          "title": "Input Count",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "source",
            "operator",
            "route",
            "script"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operator": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "position": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "script": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "default": "",
          "maxLength": 120,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "WorkflowNode",
      "type": "object"
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "properties": {
        "base_dir": {
          "default": ".",
          "maxLength": 2048,
          "title": "Base Dir",
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/WorkflowEdge"
          },
          "maxItems": 5000,
          "title": "Edges",
          "type": "array"
        },
        "format": {
          "const": "operon.workflow",
          "default": "operon.workflow",
          "title": "Format",
          "type": "string"
        },
        "interface": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface"
        },
        "manifest_extra": {
          "additionalProperties": true,
          "title": "Manifest Extra",
          "type": "object"
        },
        "name": {
          "default": "workflow",
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/WorkflowNode"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "plugin_lock": {
          "additionalProperties": true,
          "title": "Plugin Lock",
          "type": "object"
        },
        "runtime": {
          "additionalProperties": true,
          "title": "Runtime",
          "type": "object"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "WorkflowSpec",
      "type": "object"
    }
  },
  "$ref": "#/$defs/WorkflowSpec"
}
