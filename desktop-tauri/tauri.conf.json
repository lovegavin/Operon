{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Operon Studio Experimental",
  "version": "0.1.0",
  "identifier": "org.operon.studio.experimental",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../assets/branding/operon.ico"
    ]
  }
}
